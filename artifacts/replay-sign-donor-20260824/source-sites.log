  1645	/// One forward walk round; returns the sign qubit to append to the tape.
  1646	/// `rounds` is the calling traversal's own round count (see
  1647	/// [`walk_top_skip`]).
  1648	fn walk_round(
  1649	    b: &mut B,
  1650	    u: &mut Vec<QubitId>,
  1651	    v: &mut Vec<QubitId>,
  1652	    round: usize,
  1653	    rounds: usize,
  1654	) -> QubitId {
  1655	    let width = value_width(round);
  1656	    shrink_to(b, u, v, width);
  1657	    if round == 0 && fused_lift_round0_enabled() {
  1658	        return fused_lift_round0_forward(b, v);
  1659	    }
  1660	    if round == 1 && fuse_round1_enabled() {
  1661	        return fused_round1_forward(b, &u[..width], &v[..width]);
  1662	    }
  1663	    let (source, target) = if round.is_multiple_of(2) {
  1664	        (&u[..width], &v[..width])
  1665	    } else {
  1666	        (&v[..width], &u[..width])
  1667	    };
  1668	    let sign = b.alloc_qubit();
  1669	    b.cx(target[1], sign);
  1670	    b.cx(source[1], sign);
  1671	    let top_skip = walk_top_skip(round, rounds);
  1672	    match walk_low_chunk(round, width) {
  1673	        Some(low) => signed_add_wrapping_sigma_split(b, sign, source, target, true, low, top_skip),
  1674	        None => signed_add_wrapping(b, sign, source, target, true, top_skip),
  1675	    }
  1676	    for i in 0..width - 1 {
  1677	        b.swap(target[i], target[i + 1]);
  1678	    }
  1679	    b.cx(target[width - 2], target[width - 1]);
  1680	    sign
  1681	}
