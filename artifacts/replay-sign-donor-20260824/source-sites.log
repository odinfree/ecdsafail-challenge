   847	/// Fuse the odd lift `a -= (!a0)*p` with ping-pong's first add and shift.
   848	/// With `p = 2^N-f`, `h=(f-1)/2`, and `q=floor(a/2)`, the four low-bit arms are
   849	/// one sparse map: `q - p + a1*p + a0*(p+1)/2`.
   850	fn fused_lift_round0_forward(b: &mut B, v: &[QubitId]) -> QubitId {
   851	    debug_assert_eq!(v.len(), VALUE_WIDTH);
   852	    let a0 = b.alloc_qubit();
   853	    b.cx(v[0], a0);
   854	    for i in 0..VALUE_WIDTH - 1 {
   855	        b.swap(v[i], v[i + 1]);
   856	    }
   857	    b.cx(a0, v[VALUE_WIDTH - 1]);
   858
   859	    let not_a1 = b.alloc_qubit();
   860	    b.x(not_a1);
   861	    b.cx(v[0], not_a1);
   862	    let f = U256::MAX
   863	        .wrapping_sub(SECP256K1_P)
   864	        .wrapping_add(U256::from(1));
   865	    let h = f.wrapping_sub(U256::from(1)) >> 1;
   866	    if mux_round0_correction_enabled() {
   867	        mux_round0_correction(b, &v[..N], not_a1, a0, false);
   868	    } else {
   869	        cadd_nbit_const_direct_fast(b, &v[..N], f, not_a1);
   870	    }
   871	    for &q in &v[N..] {
   872	        b.cx(not_a1, q);
   873	    }
   874	    if !mux_round0_correction_enabled() {
   875	        csub_nbit_const_direct_fast(b, &v[..N], h, a0);
   876	    }
   877	    b.cx(a0, v[N - 1]);
   878
   879	    // The four output ranges are disjoint: a1=0 is negative and a1=1 positive.
   880	    b.cx(v[VALUE_WIDTH - 1], not_a1);
   881	    b.free(not_a1);
   882	    a0
   883	}
