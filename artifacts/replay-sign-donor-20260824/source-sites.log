  2659	    b.cx(add_out, sign_xor_add);
  2660	    let routed = and_clean(b, doubled_out, sign_xor_add);
  2661	    b.cx(add_out, sign_xor_add);
  2662	    b.cx(sign, sign_xor_add);
  2663	    b.free(sign_xor_add);
