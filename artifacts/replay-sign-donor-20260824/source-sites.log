  2078	/// [`add_chunked_measured`] under an explicit live-ladder budget.
  2079	pub(crate) fn add_chunked_measured_budgeted(
  2080	    b: &mut B,
  2081	    addend: &[QubitId],
  2082	    acc: &[QubitId],
  2083	    carry_out: Option<QubitId>,
  2084	    budget: usize,
  2085	) {
