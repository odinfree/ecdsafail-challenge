  2062	/// Exact value add with approximate measurement-only erasure of chunk carries.
  2063	///
  2064	/// Footprint discipline (the chunk ladder is the binding allocation at the
  2065	/// replay peak): the final carry-out is allocated only when the last chunk
  2066	/// starts, and each interior boundary carry is erased as soon as the chunk
  2067	/// that consumed it as carry-in has completed, so at most two boundary wires
  2068	/// are live at any time.
  2069	pub(crate) fn add_chunked_measured(
  2070	    b: &mut B,
