   885	/// W3: walk round 1 against the still-classical `u = p`.
   886	///
   887	/// Round 0 is already fused (`fused_lift_round0_forward`); round 1 was missed.
   888	/// Its target is `u`, which STILL HOLDS EXACTLY p, and both values are odd, so
   889	/// with `h = 2^31 + 488` and `(p+1)/2 = 2^255 - h`:
   890	///     (p+v)/2 = (p+1)/2 + (v>>1)        (p-v)/2 = (p+1)/2 - (v>>1) - 1
   891	/// The sign is `s = p[1] ^ v[1] = 1 ^ v[1]`, and XOR-ing `s` across the
   892	/// arithmetic-shifted `v>>1` produces `(-1)^s (v>>1) - s` for free, which is
   893	/// exactly the pair of arms above.  So the whole round is: clear the classical
   894	/// p (X gates), CX in `v>>1` (relabelled, free), XOR the sign (free), subtract
   895	/// the sparse `h` under a truncated borrow window, and add `2^255` as a short
   896	/// increment into the sign-extension wires.  One 257-Toffoli walk add becomes
   897	/// ~53, on all four traversal executions.
   898	fn fuse_round1_enabled() -> bool {
   899	    static SLOT: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
   900	    *SLOT.get_or_init(|| {
   901	        std::env::var("SUB4_PP_FUSE_ROUND1")
   902	            .map(|v| v != "0")
   903	            .unwrap_or(true)
   904	    })
   905	}
   906
   907	/// `(p+1)/2 = 2^255 - ROUND1_H` for `p = 2^256 - 2^32 - 977`.
   908	fn round1_h() -> U256 {
   909	    (U256::from(1) << 31) + U256::from(488)
   910	}
   911
   912	/// Borrow window for the sparse `h` correction: `h`'s top bit is 31, so this
   913	/// slice truncates the borrow 20 positions above it, matching
   914	/// `endpoint_fold_window()`.  Add and subtract use the identical slice, so the
   915	/// pair is an exact mutual inverse; the approximation is only that a borrow
   916	/// which would have run past the slice is dropped (~2^-20 per execution).
   917	fn round1_window(width: usize) -> usize {
   918	    (32 + endpoint_fold_window()).min(width)
   919	}
