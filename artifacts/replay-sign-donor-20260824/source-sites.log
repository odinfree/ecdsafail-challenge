  2726	    b.free(doubled_out);
  2727
  2728	    let phase = b.alloc_bit();
  2729	    b.hmr(add_out, phase);
  2730	    cmp_lt_phase_conditioned(
  2731	        b,
  2732	        &target[N - replay_flag_compare()..],
  2733	        &source[N - replay_flag_compare()..],
  2734	        phase,
  2735	    );
  2736	    b.free(add_out);
  2737	    for &q in target {
  2738	        b.cx(sign, q);
  2739	    }
  2740	}
