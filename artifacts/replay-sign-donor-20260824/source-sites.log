  1683	/// One reverse walk round; consumes and frees the round's sign qubit.
  1684	/// `rounds` is the calling traversal's own round count (see
  1685	/// [`walk_top_skip`]).
  1686	fn walk_back_round(
  1687	    b: &mut B,
  1688	    u: &mut Vec<QubitId>,
  1689	    v: &mut Vec<QubitId>,
  1690	    round: usize,
  1691	    sign: QubitId,
  1692	    rounds: usize,
  1693	) {
  1694	    let width = value_width(round);
  1695	    grow_to(b, u, v, width);
  1696	    if round == 0 && fused_lift_round0_enabled() {
  1697	        fused_lift_round0_reverse(b, v, sign);
  1698	        return;
  1699	    }
  1700	    if round == 1 && fuse_round1_enabled() {
  1701	        fused_round1_reverse(b, &u[..width], &v[..width], sign);
  1702	        return;
  1703	    }
  1704	    let (source, target) = if round.is_multiple_of(2) {
  1705	        (&u[..width], &v[..width])
  1706	    } else {
  1707	        (&v[..width], &u[..width])
  1708	    };
  1709	    b.cx(target[width - 2], target[width - 1]);
  1710	    for i in (0..width - 1).rev() {
  1711	        b.swap(target[i], target[i + 1]);
  1712	    }
  1713	    b.x(sign);
  1714	    let top_skip = walk_top_skip(round, rounds);
  1715	    match walk_low_chunk(round, width) {
  1716	        Some(low) => signed_add_wrapping_sigma_split(b, sign, source, target, false, low, top_skip),
  1717	        None => signed_add_wrapping(b, sign, source, target, false, top_skip),
  1718	    }
  1719	    b.x(sign);
  1720	    b.cx(target[1], sign);
  1721	    b.cx(source[1], sign);
  1722	    b.free(sign);
  1723	}
