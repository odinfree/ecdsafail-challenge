   921	fn fused_round1_forward(b: &mut B, u: &[QubitId], v: &[QubitId]) -> QubitId {
   922	    let width = u.len();
   923	    debug_assert_eq!(width, v.len());
   924	    debug_assert!(width > N);
   925	    let sign = b.alloc_qubit();
   926	    b.cx(u[1], sign);
   927	    b.cx(v[1], sign);
   928	    // u still holds the classical p: clear it.
   929	    for (i, &q) in u.iter().enumerate() {
   930	        if SECP256K1_P.bit(i) {
   931	            b.x(q);
   932	        }
   933	    }
   934	    // u <- arithmetic v>>1, complemented when sign = 1, i.e. (-1)^s (v>>1) - s.
   935	    for i in 0..width - 1 {
   936	        b.cx(v[i + 1], u[i]);
   937	    }
   938	    b.cx(v[width - 1], u[width - 1]);
   939	    for &q in u {
   940	        b.cx(sign, q);
  1624	fn shrink_to(b: &mut B, u: &mut Vec<QubitId>, v: &mut Vec<QubitId>, width: usize) {
  1625	    while u.len() > width {
  1626	        let (lu, lv) = (u.len(), v.len());
  1627	        b.cx(u[lu - 2], u[lu - 1]);
  1628	        b.cx(v[lv - 2], v[lv - 1]);
  1629	        b.free(u.pop().expect("u has the scheduled width"));
  1630	        b.free(v.pop().expect("v has the scheduled width"));
  1631	    }
  1632	}
  1633
  1634	fn grow_to(b: &mut B, u: &mut Vec<QubitId>, v: &mut Vec<QubitId>, width: usize) {
  1635	    while u.len() < width {
  1636	        let next_u = b.alloc_qubit();
  1637	        let next_v = b.alloc_qubit();
  1638	        b.cx(u[u.len() - 1], next_u);
  1639	        b.cx(v[v.len() - 1], next_v);
  1640	        u.push(next_u);
  1641	        v.push(next_v);
  1642	    }
  1643	}
