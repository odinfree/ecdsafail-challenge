  2686	        b,
  2687	        &target[..replay_fold_window_mul()],
  2688	        f,
  2689	        &negative_f,
  2690	        add_out,
  2691	        Some(plus_2f),
  2692	        minus_f,
  2693	        first_carry,
  2694	    );
  2695
  2696	    b.cx(minus_f, add_out);
  2697	    b.cx(doubled_out, add_out);
  2698	    let odd_correction = b.alloc_qubit();
  2699	    b.cx(doubled_out, odd_correction);
  2700	    b.cx(add_out, odd_correction);
  2701	    b.cx(odd_correction, target[0]);
  2702	    and_uncompute(b, first_carry, target[0], odd_correction);
  2703	    b.cx(odd_correction, target[0]);
  2704	    b.cx(doubled_out, odd_correction);
  2705	    b.cx(add_out, odd_correction);
  2706	    b.free(odd_correction);
  2707
  2708	    b.cx(minus_f, plus_2f);
  2709	    b.cx(routed, plus_2f);
  2710	    b.free(plus_2f);
  2711	    and_uncompute(b, minus_f, routed, sign);
  2712	    let sign_xor_add = b.alloc_qubit();
  2713	    b.cx(sign, sign_xor_add);
  2714	    b.cx(add_out, sign_xor_add);
  2715	    and_uncompute(b, routed, doubled_out, sign_xor_add);
  2716	    b.cx(add_out, sign_xor_add);
  2717	    b.cx(sign, sign_xor_add);
  2718	    b.free(sign_xor_add);
