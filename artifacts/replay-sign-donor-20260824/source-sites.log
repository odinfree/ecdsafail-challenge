  1964	/// One Gidney chunk, preserving the addend and carry-in and optionally
  1965	/// retaining the carry-out.  Every owned carry is measurement-uncomputed.
  1966	fn chunk_add(
  1967	    b: &mut B,
  1968	    addend: &[QubitId],
  1969	    acc: &[QubitId],
  1970	    carry_in: Option<QubitId>,
  1971	    carry_out: Option<QubitId>,
  1972	) {
  1973	    let width = addend.len();
  1974	    assert_eq!(width, acc.len());
  1975	    if width == 0 {
  1976	        return;
  1977	    }
  1978	    let num_carries = if carry_out.is_some() {
  1979	        width
  1980	    } else {
  1981	        width - 1
  1982	    };
  1983	    if num_carries == 0 {
  1984	        if let Some(carry) = carry_in {
  1985	            b.cx(carry, acc[0]);
  1986	        }
  1987	        b.cx(addend[0], acc[0]);
  1988	        return;
  1989	    }
  1990
  1991	    let owned = num_carries - usize::from(carry_out.is_some());
  1992	    let mut carries = b.alloc_qubits(owned);
  1993	    if let Some(carry) = carry_out {
  1994	        carries.push(carry);
  1995	    }
  1996
  1997	    for i in 0..num_carries {
  1998	        let previous = if i == 0 {
  1999	            carry_in
  2000	        } else {
  2001	            Some(carries[i - 1])
  2002	        };
  2003	        if let Some(previous) = previous {
  2004	            b.cx(previous, addend[i]);
  2005	            b.cx(previous, acc[i]);
  2006	        }
  2007	        b.ccx(addend[i], acc[i], carries[i]);
  2008	        if let Some(previous) = previous {
  2009	            b.cx(previous, carries[i]);
  2010	        }
  2011	    }
  2012
  2013	    if carry_out.is_some() {
  2014	        let i = width - 1;
  2015	        let previous = if i == 0 {
  2016	            carry_in
  2017	        } else {
  2018	            Some(carries[i - 1])
  2019	        };
  2020	        if let Some(previous) = previous {
  2021	            b.cx(previous, addend[i]);
  2022	        }
  2023	        b.cx(addend[i], acc[i]);
  2024	    } else {
  2025	        b.cx(carries[num_carries - 1], acc[width - 1]);
  2026	        b.cx(addend[width - 1], acc[width - 1]);
  2027	    }
  2028
  2029	    for i in (0..owned).rev() {
  2030	        let previous = if i == 0 {
  2031	            carry_in
  2032	        } else {
  2033	            Some(carries[i - 1])
  2034	        };
  2035	        if let Some(previous) = previous {
  2036	            b.cx(previous, carries[i]);
  2037	        }
  2038	        let measured = b.alloc_bit();
  2039	        b.hmr(carries[i], measured);
  2040	        b.cz_if(addend[i], acc[i], measured);
  2041	        if let Some(previous) = previous {
  2042	            b.cx(previous, addend[i]);
  2043	        }
  2044	        b.cx(addend[i], acc[i]);
  2045	    }
  2046	    b.free_vec(&carries[..owned]);
  2047	}
