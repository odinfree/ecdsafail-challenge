  1747	fn replay_doubling_round(b: &mut B, round: usize, sign: QubitId, x: &[QubitId], y: &[QubitId]) {
  1748	    let fused = std::env::var_os("SUB4_PINGPONG_UNFUSED_INVERSE").is_none();
  1749	    let (source, target) = if round.is_multiple_of(2) { (x, y) } else { (y, x) };
  1750	    if fused && round > 1 {
  1751	        b.x(sign);
  1752	        signed_mod_double_add_pm_fused(b, sign, source, target);
  1753	        b.x(sign);
  1754	    } else {
  1755	        mod_double_pm(b, target);
  1756	    }
  1757	    if round == 1 {
  1758	        seed_round_one_inverse(b, sign, source, target);
  1759	    } else if round > 1 && !fused {
  1760	        b.x(sign);
  1761	        signed_mod_add_pm(b, sign, source, target);
  1762	        b.x(sign);
  1763	    }
  1764	}
  1766	/// Interleaving schedule.  `r1`: rounds below it are replayed in one batch;
  1767	/// `r2`: rounds above it are replayed in one batch at the loaned terminal
  1768	/// state; rounds in `r1..=r2` are replayed right after their walk round
  1769	/// (divide) or right before their walk-back round (multiply).  `peak` is the
  1770	/// width budget the per-round chunk counts are chosen against.
  1771	struct Plan {
  1772	    r1: usize,
  1773	    r2: usize,
  1774	    peak: usize,
  1775	}
  1776
  1777	fn plan(direction: PingPongDirection, rounds: usize) -> Option<Plan> {
  1778	    if std::env::var_os("SUB4_PP_NO_INTERLEAVE").is_some() {
  1779	        return None;
  1780	    }
  1781	    let env = |name: &str, default: usize| {
  1782	        std::env::var(name)
  1783	            .ok()
  1784	            .and_then(|v| v.parse::<usize>().ok())
  1785	            .unwrap_or(default)
  1786	    };
  1787	    // 298, not 509: with the exact split walk adder (`walk_low_chunk`) a walk
  1788	    // round no longer needs its full-width carry ladder, so the batch replay can
  1789	    // run at a checkpoint where the tape is 200 rounds shorter and the walk
  1790	    // registers, though wider, cost less than the tape saves.  That lifts the
  1791	    // batch's chunk-ladder budget from 87 to 130 - the 129 a *two*-chunk layout
  1792	    // needs - so the batch's ~296 replay rounds per traversal pay ONE 23-bit
  1793	    // boundary repair instead of two, and the ~210 rounds now interleaved below
  1794	    // the old r1 pay between one and two.  Net -2,848 executed Toffoli at the
  1795	    // same 1,278 qubits, and 3,100 -> 2,405 truncated repairs per shot, so the
  1796	    // measured-erasure exposure (lambda) goes down as well.
  1797	    // `SUB4_PP_R1=509 SUB4_PP_R2=610` restores the previous op stream byte for
  1798	    // byte: at r1=509 no walk round is ever over budget, so nothing splits.
  1799	    // The replay and square are co-binders: this cut only lowers global width
  1800	    // when the square carry ladder is reduced in the same circuit.
  1801	    // 340/628, not 342/625: re-tuned against the compressed width schedule,
  1802	    // whose narrower interleaved walk registers move the cheapest chunk
  1803	    // layouts by a few rounds in both directions.
  1804	    //
  1805	    // REBASE (2026-08-23, 4eb93cb): our own R1=344/R2=664/PEAK=1278 is stale
  1806	    // on this base; kept upstream's triple pending a fresh coordinate-ascent
  1807	    // re-sweep. MERGE: R1 is now per-direction (theirs), so the multiply
  1808	    // traversal can sit at its own checkpoint via `SUB4_PP_R1_MUL`.
  1809	    let r1 = match direction {
  1810	        PingPongDirection::Divide => env("SUB4_PP_R1", 341),
  1811	        PingPongDirection::Multiply => env("SUB4_PP_R1_MUL", env("SUB4_PP_R1", 341)),
  1812	    };
  1813	    let r2 = env("SUB4_PP_R2", 628);
  1814	    let r1 = r1.min(rounds);
  1815	    let r2 = r2.min(rounds.saturating_sub(1));
  1816	    let peak = env("SUB4_PP_PEAK", 1273);
  1817	    Some(Plan { r1, r2, peak })
  1818	}
