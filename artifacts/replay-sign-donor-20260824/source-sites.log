  1820	/// Footprint outside the replay cell at an interleaved round: tape (round+1
  1821	/// signs), both coefficient registers, and the two walk registers at their
  1822	/// current width.
  1823	fn allowance(plan: &Plan, tape_len: usize, walk_width: usize) -> usize {
  1824	    plan.peak.saturating_sub(tape_len + 2 * N + 2 * walk_width)
