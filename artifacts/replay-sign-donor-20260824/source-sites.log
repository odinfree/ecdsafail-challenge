  1957	fn and_uncompute(b: &mut B, out: QubitId, a: QubitId, c: QubitId) {
  1958	    let measured = b.alloc_bit();
  1959	    b.hmr(out, measured);
  1960	    b.cz_if(a, c, measured);
  1961	    b.free(out);
