  2092	/// Like [`add_chunked_measured`] but allocates the carry-out wire itself,
  2093	/// only when the last chunk starts, and returns it.
  2094	fn add_chunked_measured_late_carry(b: &mut B, addend: &[QubitId], acc: &[QubitId]) -> QubitId {
