  1834	fn value_walk(b: &mut B, u: &mut Vec<QubitId>, v: &mut Vec<QubitId>, rounds: usize) -> Vec<QubitId> {
  1835	    let mut tape = Vec::with_capacity(rounds);
  1836	    for round in 0..rounds {
  1837	        let width = value_width(round);
  1838	        while u.len() > width {
  1839	            let (lu, lv) = (u.len(), v.len());
  1840	            b.cx(u[lu - 2], u[lu - 1]);
  1841	            b.cx(v[lv - 2], v[lv - 1]);
  1842	            b.free(u.pop().expect("u has the scheduled width"));
  1843	            b.free(v.pop().expect("v has the scheduled width"));
  1844	        }
  1845
  1846	        if round == 0 && fused_lift_round0_enabled() {
  1847	            tape.push(fused_lift_round0_forward(b, v));
  1848	            continue;
  1849	        }
  1850	        if round == 1 && fuse_round1_enabled() {
  1851	            tape.push(fused_round1_forward(b, &u[..width], &v[..width]));
  1852	            continue;
  1853	        }
  1854
  1855	        let (source, target) = if round.is_multiple_of(2) {
  1856	            (&u[..width], &v[..width])
  1857	        } else {
  1858	            (&v[..width], &u[..width])
  1859	        };
  1860	        // REBASE (2026-08-23, 4eb93cb): upstream's `tail_share` sign-aliasing
  1861	        // (PP_TAIL_SHARE, default-off on b523ecf) was deleted upstream as
  1862	        // dead code -- it was never enabled by default, so dropping it here
  1863	        // changes nothing observable. Our `top_skip` carry-chain trim
  1864	        // (REPORT5 W-B extension) is independent of it and survives alone.
  1865	        let sign = b.alloc_qubit();
  1866	        b.cx(target[1], sign);
  1867	        b.cx(source[1], sign);
  1868	        signed_add_wrapping(b, sign, source, target, true, walk_top_skip(round, rounds));
  1869	        tape.push(sign);
  1870
  1871	        for i in 0..width - 1 {
  1872	            b.swap(target[i], target[i + 1]);
  1873	        }
  1874	        b.cx(target[width - 2], target[width - 1]);
  1875	    }
  1876	    tape
  1877	}
