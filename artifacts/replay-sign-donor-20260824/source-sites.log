  2098	fn add_chunked_measured_with(
  2099	    b: &mut B,
  2100	    addend: &[QubitId],
  2101	    acc: &[QubitId],
  2102	    carry_out: Option<QubitId>,
  2103	    late_carry_out: bool,
  2104	) -> Option<QubitId> {
  2105	    let n = addend.len();
  2106	    let final_carry = carry_out.is_some() || late_carry_out;
  2107	    let bounds = match ladder_target_now() {
  2108	        None => chunk_bounds(n, replay_chunk()),
  2109	        Some(v) => match legacy_width(v) {
  2110	            Some(width) => chunk_bounds(n, width),
  2111	            None => chunk_layout(n, v, final_carry)
  2112	                .unwrap_or_else(|| chunk_bounds(n, n.div_ceil(12))),
  2113	        },
  2114	    };
  2115	    let legacy = std::env::var_os("SUB4_PP_LEGACY_CHUNK_ORDER").is_some();
  2116	    let erase = |b: &mut B, carry: QubitId, lo: usize, hi: usize| {
  2117	        let width = hi - lo;
  2118	        let compare = replay_chunk_compare().min(width);
  2119	        let phase = b.alloc_bit();
  2120	        b.hmr(carry, phase);
  2121	        cmp_lt_phase_conditioned(b, &acc[hi - compare..hi], &addend[hi - compare..hi], phase);
  2122	        b.free(carry);
  2123	    };
  2124	    let mut live_boundaries = Vec::<(QubitId, usize, usize)>::new();
  2125	    let mut carry_in: Option<QubitId> = None;
  2126	    let mut final_carry = carry_out;
  2127	    for (index, &(lo, hi)) in bounds.iter().enumerate() {
  2128	        let last = index + 1 == bounds.len();
  2129	        let next = if last {
  2130	            if final_carry.is_none() && late_carry_out {
  2131	                final_carry = Some(b.alloc_qubit());
  2132	            }
  2133	            final_carry
  2134	        } else {
  2135	            Some(b.alloc_qubit())
  2136	        };
  2137	        chunk_add(b, &addend[lo..hi], &acc[lo..hi], carry_in, next);
  2138	        if !legacy && index >= 1 {
  2139	            // carry_in (boundary index-1) has now been fully consumed by this
  2140	            // chunk, and the chunk below it is final: erase it immediately.
  2141	            let pos = live_boundaries
  2142	                .iter()
  2143	                .position(|&(q, _, _)| Some(q) == carry_in)
  2144	                .expect("consumed boundary is live");
  2145	            let (carry, plo, phi) = live_boundaries.remove(pos);
  2146	            erase(b, carry, plo, phi);
  2147	        }
  2148	        if !last {
  2149	            live_boundaries.push((next.expect("interior carry"), lo, hi));
  2150	        }
  2151	        carry_in = next;
  2152	    }
  2153
  2154	    for index in (0..live_boundaries.len()).rev() {
  2155	        let (carry, lo, hi) = live_boundaries[index];
  2156	        erase(b, carry, lo, hi);
  2157	    }
  2158	    final_carry
  2159	}
