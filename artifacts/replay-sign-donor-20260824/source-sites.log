  2480	/// Signed-frame replay cell: `target <- (target -/+ source)/2 (mod p)`.
  2481	fn signed_mod_add_pm_halve_fused_signed(
  2482	    b: &mut B,
  2483	    sign: QubitId,
  2484	    source: &[QubitId],
  2485	    target: &[QubitId],
  2486	) {
  2487	    let f = pseudo_mersenne_f();
  2488
  2489	    // Bit 256 of the exact two's-complement sum is `carry ^ t255 ^ s255`.
  2490	    // Preload the two sign bits; the adder xors the carry-out in.
  2491	    let hi = b.alloc_qubit();
  2492	    b.cx(target[N - 1], hi);
  2493	    b.cx(source[N - 1], hi);
  2494
  2495	    for &q in target {
  2496	        b.cx(sign, q);
  2497	    }
  2498	    add_chunked_measured(b, source, target, Some(hi));
  2499	    for &q in target {
  2500	        b.cx(sign, q);
  2501	    }
  2502	    // (target, hi) now holds V = target -/+ source exactly, |V| < 2^256.
  2503
  2504	    let parity = b.alloc_qubit();
  2505	    b.cx(target[0], parity);
  2506
  2507	    // eps = -sign(V) * (V mod 2), so R = V + eps*p is even and |R| < 2^256.
  2508	    // eps*p = eps*2^256 - eps*f; +-2^256 is the same bit-256 flip mod 2^257.
  2509	    let minus_f = and_clean(b, parity, hi); // V < 0 and odd  -> add +p -> low -f
  2510	    let plus_f = b.alloc_qubit(); // V >= 0 and odd -> add -p -> low +f
  2511	    b.cx(parity, plus_f);
  2512	    b.cx(minus_f, plus_f);
  2513
  2514	    let negative_f = twos_complement_bits(f, replay_fold_window());
  2515	    fused_fold_maskfree(
  2516	        b,
  2517	        &target[..replay_fold_window()],
  2518	        f,
  2519	        &negative_f,
  2520	        plus_f,
  2521	        None,
  2522	        minus_f,
  2523	        parity,
  2524	    );
  2525
  2526	    b.cx(parity, plus_f);
  2527	    b.cx(minus_f, plus_f);
  2528	    b.free(plus_f);
  2529	    and_uncompute(b, minus_f, parity, hi);
  2530	    b.cx(parity, hi); // hi = bit 256 of R = sign(R)
  2531
  2532	    // The reduction decision.  See `signed_frame`.
  2533	    let phase = b.alloc_bit();
  2534	    b.hmr(parity, phase);
  2535	    let repair = signed_repair_compare();
  2536	    if repair > 0 {
  2537	        signed_parity_repair(b, sign, source, target, hi, phase, repair);
  2538	    }
  2539	    b.free(parity);
  2540
  2541	    // R is even: shift down, then move bit 256 into the vacated top wire.
  2542	    for i in 0..N - 1 {
  2543	        b.swap(target[i], target[i + 1]);
  2544	    }
  2545	    b.swap(hi, target[N - 1]);
  2546	    b.free(hi);
  2547	}
  2628	fn signed_mod_double_add_pm_fused(
  2629	    b: &mut B,
  2630	    sign: QubitId,
  2631	    source: &[QubitId],
  2632	    target: &[QubitId],
  2633	) {
  2634	    let f = U256::MAX
  2635	        .wrapping_sub(SECP256K1_P)
  2636	        .wrapping_add(U256::from(1));
