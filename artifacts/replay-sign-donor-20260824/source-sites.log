  2049	fn chunk_bounds(width: usize, chunk: usize) -> Vec<(usize, usize)> {
  2050	    let chunks = width.div_ceil(chunk.max(1)).max(1);
  2051	    let (base, extra) = (width / chunks, width % chunks);
  2052	    let mut bounds = Vec::with_capacity(chunks);
  2053	    let mut lo = 0;
  2054	    for index in 0..chunks {
  2055	        let size = base + usize::from(index < extra);
  2056	        bounds.push((lo, lo + size));
  2057	        lo += size;
  2058	    }
  2059	    bounds
  2060	}
