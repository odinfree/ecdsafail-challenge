  1725	fn replay_halving_round(b: &mut B, round: usize, sign: QubitId, x: &[QubitId], y: &[QubitId]) {
  1726	    let (source, target) = if round.is_multiple_of(2) { (x, y) } else { (y, x) };
  1727	    if round == 0 {
  1728	        mod_halve_pm(b, target);
  1729	    } else if round == 1 {
  1730	        seed_round_one(b, sign, source, target);
  1731	        mod_halve_pm(b, target);
  1732	    } else {
  1733	        // Rounds 0 and 1 run in the canonical frame; enter the signed frame
  1734	        // once both registers hold a residue in [0,p).
  1735	        if round == 2 && signed_frame() {
  1736	            to_signed_frame(b, x);
  1737	            to_signed_frame(b, y);
  1738	        }
  1739	        if signed_frame() {
  1740	            signed_mod_add_pm_halve_fused_signed(b, sign, source, target);
  1741	        } else {
  1742	            signed_mod_add_pm_halve_fused(b, sign, source, target);
  1743	        }
  1744	    }
  1745	}
