[[ "${FLEET_NO_SUBMIT:-0}" == 1 ]] || fail "no_submit_missing"
[[ "${FLEET_SUBMIT_MODE:-open}" == closed ]] || fail "submit_open"
[[ "${FLEET_SPEND_PROVIDER_BUDGET:-}" == *'vast_total<=2_usd_canary'* ]] || fail "canary_cap_missing"
