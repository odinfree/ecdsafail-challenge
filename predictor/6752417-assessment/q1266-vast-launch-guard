  printf 'q1266_vast_launch_guard=blocked reason=policy_missing no_submit_ack=yes\n' >&2
  exit 75
}
# shellcheck disable=SC1090
source "$POLICY"

fail() {
  printf 'q1266_vast_launch_guard=blocked reason=%s no_submit_ack=yes\n' "$1" >&2
  exit 75
}

sha256_file() {
  shasum -a 256 "$1" | awk '{print $1}'
}

require_sha() {
  local expected="$1" path="$2" actual
  [[ -f "$path" ]] || fail "missing_file"
  actual="$(sha256_file "$path")"
  [[ "$actual" == "$expected" ]] || fail "sha256_mismatch"
}

