diff --git a/src/ppcpu.cpp b/src/ppcpu.cpp
--- a/src/ppcpu.cpp
+++ b/src/ppcpu.cpp
@@ -18,0 +19,16 @@
+// Must stay byte-for-byte equivalent to ppgpu.cu::state_digest.
+static u64 state_digest(const PP_Prefix* p) {
+    u64 h = 1469598103934665603ULL;
+    auto mix = [&](const u8* d, size_t n) {
+        for (size_t i = 0; i < n; i++) {
+            h ^= d[i];
+            h *= 1099511628211ULL;
+        }
+    };
+    mix((const u8*)p->checkpoint.st, 200);
+    mix((const u8*)&p->checkpoint.n, 4);
+    mix((const u8*)p->tail, 96 * PP_OP_BYTES);
+    mix((const u8*)&p->total_ops, 8);
+    return h;
+}
+
@@ -90 +106,12 @@
-    fprintf(stderr, "ppcpu: prefix loaded, %llu ops\n", (unsigned long long)prefix.total_ops);
+    u64 digest = state_digest(&prefix);
+    if (digest != PP_EXPECTED_STATE_Q1275) {
+        fprintf(stderr,
+                "ppcpu: FATAL: state digest %016llx != expected %016llx (q1275); "
+                "refusing to run on an unknown stream\n",
+                (unsigned long long)digest,
+                (unsigned long long)PP_EXPECTED_STATE_Q1275);
+        return 2;
+    }
+    fprintf(stderr, "ppcpu: prefix loaded, %llu ops, state_digest=%016llx\n",
+            (unsigned long long)prefix.total_ops,
+            (unsigned long long)digest);
